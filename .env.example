# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/ponce-rent-a-car
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@cliente.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ponce Rent A Car <onboarding@resend.dev>

# --- Vercel Cron ---
# Vercel manda Authorization: Bearer $CRON_SECRET en cada corrida.
CRON_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payphone (Cajita de Pagos) ---
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# --- WhatsApp Business Platform / Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_ID_FULL=
WHATSAPP_API_VERSION=v21.0
ADVISOR_WHATSAPP=
ADVISOR_EMAIL=

# --- Meta Conversions API ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# --- Webhook saliente (CRM externo) ---
WEBHOOK_URL=
WEBHOOK_SECRET=
